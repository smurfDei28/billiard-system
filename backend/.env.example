# ================================================
# Saturday Nights Billiard - Backend Environment
# Copy this file to .env and fill in your values
# ================================================

# Database (Supabase PostgreSQL)
# Get from: https://supabase.com > Project Settings > Database > Connection String
# Keep the backend below the Supabase session-pool limit. Preserve any existing URL parameters.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?connection_limit=3&pool_timeout=20"

# JWT Secrets (generate random strings - use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET="REPLACE_WITH_RANDOM_64_CHAR_STRING"
JWT_REFRESH_SECRET="REPLACE_WITH_ANOTHER_RANDOM_64_CHAR_STRING"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN_PRIVILEGED="30d"   # ADMIN/STAFF default (prevents frequent auto-logout)
JWT_PASSWORD_RESET_SECRET="REPLACE_WITH_ANOTHER_RANDOM_64_CHAR_STRING"
JWT_PASSWORD_RESET_EXPIRES_IN="1h"

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:8081"
# Required for email links. Use the externally reachable HTTPS API URL in production,
# for example: https://your-api.example.com (do not include a trailing slash).
BACKEND_URL="http://localhost:3000"
# Must match the Expo app's `scheme`; used after a successful email verification.
MOBILE_APP_SCHEME="saturdaynights"
# Optional Expo Go development override, e.g. exp://192.168.100.115:8081/--/email-verified
# MOBILE_EMAIL_VERIFIED_URL=""

# Development only: required by POST /api/auth/dev/reset-verification.
# Never set this in production or expose it to the mobile app.
DEV_TEST_API_KEY="REPLACE_WITH_A_RANDOM_DEVELOPMENT_ONLY_SECRET"

# Built-in GCash simulator for demonstrations only; it never processes real money.
GCASH_SANDBOX_ENABLED=false
# success approves automatically; pending approves after GCASH_SANDBOX_PENDING_SECONDS.
GCASH_SANDBOX_DEFAULT_SCENARIO=success
GCASH_SANDBOX_PENDING_SECONDS=10

# PayMongo (Online Payments - Free to integrate, get from paymongo.com)
PAYMONGO_SECRET_KEY="sk_test_REPLACE_WITH_YOUR_KEY"
PAYMONGO_PUBLIC_KEY="pk_test_REPLACE_WITH_YOUR_KEY"

# Supabase (for real-time & storage)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="REPLACE_WITH_YOUR_ANON_KEY"
SUPABASE_SERVICE_KEY="REPLACE_WITH_YOUR_SERVICE_KEY"
# Durable public Storage bucket used only for Admin GCash/Maya QR images.
# Create this as a public bucket in Supabase Storage (default: payment-qr).
PAYMENT_QR_STORAGE_BUCKET="payment-qr"

# Email Notifications (Gmail SMTP - Free)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-billiard-hall-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="Saturday Nights Billiard <your-billiard-hall-email@gmail.com>"

# Sensor API Key (secret between Raspberry Pi and backend)
SENSOR_API_KEY="REPLACE_WITH_RANDOM_KEY_FOR_RASPBERRY_PI"

# Module Entitlement System (MES)
# Use ALL for the complete product, or a comma-separated purchased package.
# Authentication and user administration are always available.
ENABLED_MODULES="ALL"
# Example custom package:
# ENABLED_MODULES="MEMBERSHIP,TABLE_MANAGEMENT,RESERVATIONS,CAMERA_SCORING"

# Loyalty Settings
HOURS_FOR_FREE_HOUR=20          # Play 20 hours = earn 1 free hour (60 credits)
BIRTHDAY_FREE_CREDITS=60        # 1 free hour on birthday
LOW_CREDIT_THRESHOLD=30         # Alert when below 30 credits (30 minutes)
