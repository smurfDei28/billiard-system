{
  "expo": {
    "name": "Saturday Nights Billiard",
    "slug": "saturday-nights",
    "scheme": "saturdaynights",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0A0E1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.saturdaynights.billiard"
    },
    "android": {
      "package": "ph.saturdaynights.billiard",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Saturday Nights Billiard to select QR codes and payment receipt screenshots.",
          "cameraPermission": "Allow Saturday Nights Billiard to take payment receipt photos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0a1b137f-3112-4967-9303-777f7d1c16c4"
      }
    },
    "owner": "deiejays-organization"
  }
}
